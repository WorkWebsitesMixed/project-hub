# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# Supabase → Project Settings → Data API / API Keys
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Google Workspace domain allowed to sign in.
# NOTE: students at Marymount share this domain, so the domain check is only
# the first gate — approved-teacher status is what actually grants access.
PUBLIC_ALLOWED_EMAIL_DOMAIN="marymount.edu.co"

# Public origin, used to build the OAuth redirect URL.
PUBLIC_SITE_URL="http://localhost:4321"

# ── Email notifications (optional) ───────────────────────────────────────────
# Leave all of this unset and the hub runs in-app only: no email is sent,
# nothing errors.
#
# Option A — a Google Workspace mailbox (recommended for Marymount).
# marymount.edu.co already publishes SPF, DKIM and DMARC for Workspace, so a
# school mailbox inherits authentication that already works and needs NO DNS
# change. SMTP_PASS is a 16-character app password with the spaces removed —
# not the account password. Generating one requires 2-Step Verification on
# that account, which is the whole reason app passwords exist.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="projecthub@marymount.edu.co"
SMTP_PASS=""
EMAIL_FROM="Project Hub <projecthub@marymount.edu.co>"

# Option B — Resend, used only when no SMTP_* values are set. Needs three DNS
# records (SPF, DKIM, DMARC) on a domain you control.
RESEND_API_KEY=""
