# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# Supabase → Project Settings → Data API / API Keys
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Google Workspace domain allowed to sign in.
# NOTE: students at Marymount share this domain, so the domain check is only
# the first gate — approved-teacher status is what actually grants access.
PUBLIC_ALLOWED_EMAIL_DOMAIN="marymount.edu.co"

# Public origin, used to build the OAuth redirect URL.
PUBLIC_SITE_URL="http://localhost:4321"

# ── Email notifications (optional) ───────────────────────────────────────────
# Leave RESEND_API_KEY unset and the hub runs in-app only: no email is sent,
# nothing errors. Set it to switch collaboration emails on.
#
# EMAIL_FROM must use a domain verified in Resend. Resend's shared
# onboarding@resend.dev address only delivers to the account owner, so it is
# fine for a smoke test and useless for real staff mail.
RESEND_API_KEY=""
EMAIL_FROM="Project Hub <projecthub@marymount.edu.co>"
