# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# Supabase → Project Settings → Data API / API Keys
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only. Bypasses Row Level Security — used by the admin approval flow.
# Must never be exposed to the browser, so it has no PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Workspace domain allowed to sign in.
# NOTE: students at Marymount share this domain, so the domain check is only
# the first gate — approved-teacher status is what actually grants access.
PUBLIC_ALLOWED_EMAIL_DOMAIN="marymount.edu.co"

# Comma-separated emails bootstrapped as admins on first sign-in.
ADMIN_EMAILS="dyrtull@gmail.com"

# Public origin, used to build the OAuth redirect URL.
PUBLIC_SITE_URL="http://localhost:4321"
