---
import Layout from '../layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations, localizePath, localized } from '../i18n/utils';
import { GRADES, subjectsForGrade, FAMILIES } from '../lib/subjects';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const isApproved = Astro.locals.profile?.status === 'approved';
// Set by the middleware when someone tries to reach a protected page signed out.
const signInRequired = Astro.url.searchParams.get('signin') === 'required';
const nextPath = Astro.url.searchParams.get('next');
---

<Layout>
  <section class="max-w-3xl">
    <p class="text-sm font-medium uppercase tracking-widest text-ink-muted">
      {t('site.tagline')}
    </p>
    <h1 class="mt-3 text-4xl font-bold leading-tight text-navy sm:text-5xl">
      {t('home.heroTitle')}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-muted">
      {t('home.heroBody')}
    </p>

    {
      signInRequired && (
        <p class="mt-6 rounded-lg border border-amber bg-amber-tint px-4 py-3 text-sm text-navy">
          Please sign in with your school Google account to continue.
        </p>
      )
    }

    <div class="mt-8 flex flex-wrap gap-3">
      {
        isApproved ? (
          <>
            <a
              href={localizePath('/projects', locale)}
              class="rounded-lg bg-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-soft"
            >
              {t('home.cta')}
            </a>
            <a
              href={localizePath('/projects/new', locale)}
              class="rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-surface-sunken"
            >
              {t('home.ctaSecondary')}
            </a>
          </>
        ) : (
          <a
            href={`/auth/signin${nextPath ? `?next=${encodeURIComponent(nextPath)}` : ''}`}
            class="rounded-lg bg-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-soft"
          >
            {t('nav.signIn')}
          </a>
        )
      }
    </div>
  </section>

  <!--
    The catalog, rendered with the real family colours. This doubles as a
    living check that every subject is tagged to the right grades — if a
    subject is missing from a column, it is missing from src/lib/subjects.ts.
  -->
  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">
      Subject catalog
    </h2>

    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        GRADES.map((grade) => (
          <div class="rounded-card border border-line p-5">
            <h3 class="text-lg font-semibold text-navy">Grade {grade}</h3>
            <p class="mt-0.5 text-xs text-ink-muted">
              {subjectsForGrade(grade).length} subjects
            </p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {subjectsForGrade(grade).map((subject) => (
                <li class={`chip family-${subject.family}`}>
                  {localized(subject.name, locale)}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-ink-muted">
      {
        Object.entries(FAMILIES).map(([key, family]) => (
          <span class={`chip family-${key}`}>
            {localized(family.label, locale)}
          </span>
        ))
      }
    </div>
  </section>
</Layout>
