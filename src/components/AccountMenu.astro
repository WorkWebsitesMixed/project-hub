---
import { getLocaleFromUrl, useTranslations, localizePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const { user, profile } = Astro.locals;
const displayName = profile?.full_name ?? user?.email ?? '';
const initials = displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((part: string) => part[0] ?? '')
  .join('')
  .toUpperCase();
---

{
  user ? (
    <div class="flex items-center gap-2">
      {profile?.avatar_url ? (
        <img
          src={profile.avatar_url}
          alt=""
          width="28"
          height="28"
          class="h-7 w-7 rounded-full border border-line"
          referrerpolicy="no-referrer"
        />
      ) : (
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-full bg-navy text-[11px] font-semibold text-white"
        >
          {initials}
        </span>
      )}

      <span class="hidden text-xs text-ink-muted sm:inline" title={user.email}>
        {profile?.full_name ?? user.email}
      </span>

      {profile?.role === 'admin' && (
        <a
          href={localizePath('/admin/approvals', locale)}
          class="rounded-md border border-line px-2 py-1 text-xs font-medium text-navy transition hover:bg-surface-sunken"
        >
          Admin
        </a>
      )}

      <form method="POST" action="/auth/signout">
        <button
          type="submit"
          class="rounded-md px-2 py-1 text-xs text-ink-muted transition hover:bg-surface-sunken hover:text-navy"
        >
          {t('nav.signOut')}
        </button>
      </form>
    </div>
  ) : (
    <a
      href="/auth/signin"
      class="rounded-lg bg-navy px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-navy-soft"
    >
      {t('nav.signIn')}
    </a>
  )
}
