---
import Layout from '../../layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations, localizePath, localized } from '../../i18n/utils';
import { STATUS_LABELS, subjectBySlug, GRADES, subjectsForGrade } from '../../lib/subjects';
import type { ProjectDetailData } from '../../lib/pageLoaders';

interface Props {
  data: ProjectDetailData;
}

// Pure renderer. All loading, form handling and redirecting happens in
// loadProjectDetail() and is acted on by the page wrapper — a component cannot
// perform a redirect, and silently failing to do so is what produced a blank
// page here before.
const { data } = Astro.props;
const {
  project,
  owner,
  grades,
  tags,
  attachments,
  hasOfferedToCollaborate,
  isOwner,
  canEdit,
  actionError,
} = data;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const chips = tags.map((tag) => {
  const subject = subjectBySlug(tag.slug);
  return {
    role: tag.role,
    grade: tag.grade,
    family: subject?.family ?? 'stem',
    name: subject ? localized(subject.name, locale) : tag.slug,
  };
});

const primaryChips = chips.filter((c) => c.role === 'primary');
const crossChips = chips.filter((c) => c.role === 'cross');
---

<Layout title={project.title} description={project.description.slice(0, 160)}>
  <a
    href={localizePath('/projects', locale)}
    class="text-sm text-ink-muted transition hover:text-navy"
  >
    ← {t('project.back')}
  </a>

  {
    actionError && (
      <p class="mt-4 rounded-lg border border-magenta bg-magenta-tint px-4 py-3 text-sm text-navy">
        {actionError}
      </p>
    )
  }

  <article class="mt-4 grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip tone-cyan">{STATUS_LABELS[project.status][locale]}</span>
        {grades.map((g) => <span class="chip">{t('form.grade')} {g}</span>)}
        {
          project.language !== locale && (
            <span class="chip tone-amber">{project.language.toUpperCase()}</span>
          )
        }
      </div>

      <h1 class="mt-4 text-3xl font-bold leading-tight text-navy">{project.title}</h1>

      <p class="mt-2 text-sm text-ink-muted">
        {t('project.by')}{' '}
        <a href={`mailto:${owner?.email}`} class="font-medium text-purple hover:underline">
          {owner?.full_name ?? owner?.email}
        </a>
      </p>

      {
        project.description && (
          <div class="mt-6 whitespace-pre-wrap leading-relaxed text-ink">
            {project.description}
          </div>
        )
      }

      {
        attachments.length > 0 && (
          <section class="mt-8">
            <h2 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">
              {t('project.attachments')}
            </h2>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {attachments.map((file) => (
                <li class="overflow-hidden rounded-card border border-line">
                  {file.mime_type?.startsWith('image/') && file.url ? (
                    <a href={file.url} target="_blank" rel="noopener">
                      <img src={file.url} alt={file.file_name} class="h-40 w-full object-cover" />
                    </a>
                  ) : (
                    <a
                      href={file.url ?? '#'}
                      target="_blank"
                      rel="noopener"
                      class="block px-4 py-3 text-sm text-navy hover:underline"
                    >
                      {file.file_name}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="space-y-8">
      <section>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">
          {t('project.primary')}
        </h2>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {
            primaryChips.map((c) => (
              <span class={`chip chip-primary family-${c.family}`}>
                {c.name} · {c.grade}
              </span>
            ))
          }
        </div>
      </section>

      {
        crossChips.length > 0 && (
          <section>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">
              {t('project.cross')}
            </h2>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {crossChips.map((c) => (
                <span class={`chip family-${c.family}`}>
                  {c.name} · {c.grade}
                </span>
              ))}
            </div>
          </section>
        )
      }

      {
        project.duration && (
          <section>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">
              {t('project.duration')}
            </h2>
            <p class="mt-1 text-sm text-ink">{project.duration}</p>
          </section>
        )
      }

      {
        project.resources && (
          <section>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">
              {t('project.resources')}
            </h2>
            <p class="mt-1 whitespace-pre-wrap text-sm text-ink">{project.resources}</p>
          </section>
        )
      }

      <section class="rounded-card border border-line p-4">
        {
          isOwner ? (
            <p class="text-sm text-ink-muted">{t('project.ownProject')}</p>
          ) : hasOfferedToCollaborate ? (
            <p class="text-sm font-medium text-navy">✓ {t('project.collabAlready')}</p>
          ) : (
            <form method="POST" class="space-y-3">
              <input type="hidden" name="action" value="collaborate" />

              <!--
                The subject the volunteer is bringing. Asked here rather than
                stored on their profile: a teacher who takes both Chemistry and
                Physics knows exactly which one applies to THIS project, and a
                profile field would go stale the next time a timetable changed.
                This is the value that draws the confirmed line on the graph.
              -->
              <label class="block">
                <span class="text-sm font-semibold text-navy">
                  {t('project.offerSubject')}
                </span>
                <span class="mt-0.5 block text-xs text-ink-muted">
                  {t('project.offerSubjectHint')}
                </span>
                <select
                  name="offered_subject"
                  required
                  class="mt-2 w-full rounded-lg border border-line px-3 py-2 text-sm text-navy"
                >
                  <option value="">{t('project.offerSubjectPlaceholder')}</option>
                  {GRADES.map((grade) => (
                    <optgroup label={`${t('form.grade')} ${grade}`}>
                      {subjectsForGrade(grade).map((subject) => (
                        <option value={`${subject.slug}@${grade}`}>
                          {localized(subject.name, locale)}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </label>

              <textarea
                name="message"
                rows={3}
                placeholder={t('project.collabMessage')}
                class="w-full rounded-lg border border-line px-3 py-2 text-sm text-navy placeholder:text-ink-muted"
              />
              <button
                type="submit"
                class="w-full rounded-lg bg-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-soft"
              >
                {t('project.collaborate')}
              </button>
            </form>
          )
        }
      </section>

      {
        canEdit && (
          <section class="flex gap-2">
            <a
              href={localizePath(`/projects/${project.id}/edit`, locale)}
              class="rounded-lg border border-line px-4 py-2 text-sm font-medium text-navy transition hover:bg-surface-sunken"
            >
              {t('project.edit')}
            </a>
            <form
              method="POST"
              onsubmit={`return confirm(${JSON.stringify(t('project.deleteConfirm'))})`}
            >
              <input type="hidden" name="action" value="delete" />
              <button
                type="submit"
                class="rounded-lg border border-line px-4 py-2 text-sm font-medium text-ink-muted transition hover:bg-magenta-tint hover:text-navy"
              >
                {t('project.delete')}
              </button>
            </form>
          </section>
        )
      }
    </aside>
  </article>
</Layout>
