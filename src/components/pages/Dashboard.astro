---
import Layout from '../../layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { STATUS_LABELS } from '../../lib/subjects';
import type { DashboardData } from '../../lib/pageLoaders';

interface Props {
  data: DashboardData;
}

// Pure renderer — see src/lib/pageLoaders.ts for why.
const { data } = Astro.props;
const { myProjects, received, sent, emailNotifications, error } = data;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Unanswered offers come first — they are the only ones needing a decision.
const waiting = received.filter((r) => r.status === 'interested');
const answered = received.filter((r) => r.status !== 'interested');
---

<Layout title={t('dash.title')}>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="text-3xl font-bold text-navy">{t('dash.title')}</h1>
    <a
      href={localizePath('/projects/new', locale)}
      class="rounded-lg bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-navy-soft"
    >
      {t('nav.new')}
    </a>
  </div>

  {
    error && (
      <p class="mt-6 rounded-lg border border-magenta bg-magenta-tint px-4 py-3 text-sm text-navy">
        {error}
      </p>
    )
  }

  <div class="mt-10 grid gap-10 lg:grid-cols-3">
    <section class="lg:col-span-2">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">
        {t('dash.myProjects')}
      </h2>

      {
        myProjects.length > 0 ? (
          <ul class="mt-4 divide-y divide-line rounded-card border border-line">
            {myProjects.map((p) => (
              <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                <a
                  href={localizePath(`/projects/${p.id}`, locale)}
                  class="font-medium text-navy hover:underline"
                >
                  {p.title}
                </a>
                <span class="chip">{STATUS_LABELS[p.status][locale]}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 rounded-card border border-dashed border-line px-4 py-8 text-center text-sm text-ink-muted">
            {t('dash.noProjects')}
          </p>
        )
      }

      <!--
        The inbox. This is the half of "I want to collaborate" the project
        owner sees — the button on the project page is only ever visible to
        someone who is not the owner.
      -->
      <h2 class="mt-12 text-sm font-semibold uppercase tracking-widest text-ink-muted">
        {t('dash.interest')}
        {waiting.length > 0 && <span class="chip tone-amber ml-2">{waiting.length}</span>}
      </h2>

      {
        received.length === 0 ? (
          <p class="mt-4 text-sm text-ink-muted">{t('dash.noInterest')}</p>
        ) : (
          <ul class="mt-4 space-y-3">
            {[...waiting, ...answered].map((request) => (
              <li
                class:list={[
                  'rounded-card border p-4',
                  request.status === 'interested' ? 'border-amber' : 'border-line',
                ]}
              >
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-medium text-navy">
                      {request.requester?.full_name ?? request.requester?.email}
                    </p>
                    {request.project && (
                      <a
                        href={localizePath(`/projects/${request.project.id}`, locale)}
                        class="text-xs text-ink-muted hover:text-navy hover:underline"
                      >
                        {request.project.title}
                      </a>
                    )}
                  </div>

                  {request.status === 'interested' ? (
                    <span class="chip tone-amber">{t('dash.waiting')}</span>
                  ) : request.status === 'accepted' ? (
                    <span class="chip tone-green">{t('dash.onTheTeam')}</span>
                  ) : (
                    <span class="chip">{t('dash.declined')}</span>
                  )}
                </div>

                {request.message && (
                  <p class="mt-3 border-l-2 border-line pl-3 text-sm leading-relaxed text-ink-muted">
                    {request.message}
                  </p>
                )}

                <div class="mt-3 flex flex-wrap items-center gap-2">
                  {request.status === 'interested' && (
                    <>
                      <form method="POST">
                        <input type="hidden" name="action" value="respond" />
                        <input type="hidden" name="request_id" value={request.id} />
                        <input type="hidden" name="decision" value="accept" />
                        <button
                          type="submit"
                          title={t('dash.acceptHint')}
                          class="rounded-md bg-navy px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-navy-soft"
                        >
                          {t('dash.accept')}
                        </button>
                      </form>
                      <form method="POST">
                        <input type="hidden" name="action" value="respond" />
                        <input type="hidden" name="request_id" value={request.id} />
                        <input type="hidden" name="decision" value="decline" />
                        <button
                          type="submit"
                          class="rounded-md border border-line px-3 py-1.5 text-xs font-medium text-ink-muted transition hover:bg-surface-sunken hover:text-navy"
                        >
                          {t('dash.decline')}
                        </button>
                      </form>
                    </>
                  )}

                  {request.requester?.email && (
                    <a
                      href={`mailto:${request.requester.email}`}
                      class="text-xs font-medium text-purple hover:underline"
                    >
                      {request.requester.email}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <aside class="space-y-8">
      <!--
        The opt-out. Teachers get enough email; forcing it would make the hub
        something people mute rather than use.
      -->
      <section class="rounded-card border border-line p-4">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">
          {t('dash.emailTitle')}
        </h2>
        <form method="POST" class="mt-3">
          <input type="hidden" name="action" value="email_prefs" />
          <label class="flex items-start gap-2.5">
            <input
              type="checkbox"
              name="enabled"
              checked={emailNotifications}
              class="mt-0.5 h-4 w-4 shrink-0 accent-[color:var(--color-navy)]"
            />
            <span>
              <span class="block text-sm text-navy">{t('dash.emailOn')}</span>
              <span class="mt-0.5 block text-xs text-ink-muted">{t('dash.emailHint')}</span>
            </span>
          </label>
          <button
            type="submit"
            class="mt-3 rounded-md border border-line px-3 py-1.5 text-xs font-medium text-navy transition hover:bg-surface-sunken"
          >
            {t('dash.emailSave')}
          </button>
        </form>
      </section>

      {
        sent.length > 0 && (
          <section>
            <h2 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">
              {t('dash.myInterest')}
            </h2>
            <ul class="mt-4 space-y-2 text-sm">
              {sent.map((request) => (
                <li class="flex items-center justify-between gap-2">
                  <a
                    href={localizePath(`/projects/${request.project?.id}`, locale)}
                    class="min-w-0 truncate text-navy hover:underline"
                  >
                    {request.project?.title}
                  </a>
                  <span
                    class:list={[
                      'chip shrink-0',
                      request.status === 'accepted'
                        ? 'tone-green'
                        : request.status === 'declined'
                          ? ''
                          : 'tone-amber',
                    ]}
                  >
                    {request.status === 'accepted'
                      ? t('dash.onTheTeam')
                      : request.status === 'declined'
                        ? t('dash.declined')
                        : t('project.collaborateSent')}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</Layout>
