---
import Layout from '../../layouts/Layout.astro';
import ProjectForm from '../ProjectForm';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';
import type { ProjectEditorData } from '../../lib/pageLoaders';

interface Props {
  data: ProjectEditorData;
}

// Pure renderer — loading and redirecting live in loadProjectEditor(), because
// a redirect returned from a component is silently discarded.
const { data } = Astro.props;
const initial = data.initial;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const labels = {
  title: t('form.title'),
  description: t('form.description'),
  descriptionHint: t('form.descriptionHint'),
  grades: t('form.grades'),
  grade: t('form.grade'),
  primary: t('form.primary'),
  primaryHint: t('form.primaryHint'),
  cross: t('form.cross'),
  crossHint: t('form.crossHint'),
  status: t('form.status'),
  language: t('form.language'),
  languageHint: t('form.languageHint'),
  duration: t('form.duration'),
  durationHint: t('form.durationHint'),
  durationPlaceholder: t('form.durationPlaceholder'),
  resources: t('form.resources'),
  resourcesHint: t('form.resourcesHint'),
  files: t('form.files'),
  filesHint: t('form.filesHint'),
  submit: t('form.submit'),
  saving: t('form.saving'),
  cancel: t('form.cancel'),
  noneSelected: t('form.noneSelected'),
  selectedSuffix: t('form.selectedSuffix'),
  errorTitle: t('form.errorTitle'),
  errorGrades: t('form.errorGrades'),
  errorPrimary: t('form.errorPrimary'),
  errorGeneric: t('form.errorGeneric'),
};

const pickerLabels = {
  search: t('picker.search'),
  allGrades: t('picker.allGrades'),
  allFamilies: t('picker.allFamilies'),
  clear: t('picker.clear'),
  noMatches: t('picker.noMatches'),
};

const heading = initial ? t('edit.title') : t('new.title');
---

<Layout title={heading}>
  <div class="mx-auto max-w-2xl">
    <h1 class="text-3xl font-bold text-navy">{heading}</h1>
    {!initial && <p class="mt-2 leading-relaxed text-ink-muted">{t('new.intro')}</p>}

    <div class="mt-8">
      <ProjectForm
        client:load
        locale={locale}
        initial={initial}
        labels={labels}
        pickerLabels={pickerLabels}
      />
    </div>
  </div>
</Layout>
