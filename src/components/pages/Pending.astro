---
import Layout from '../../layouts/Layout.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const { user, profile } = Astro.locals;
const wasRejected = profile?.status === 'rejected';
---

<Layout title={t('auth.pendingTitle')}>
  <section class="mx-auto max-w-xl py-12 text-center">
    <div
      class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-tint text-2xl"
      aria-hidden="true"
    >
      ⏳
    </div>

    <h1 class="mt-6 text-2xl font-bold text-navy">{t('auth.pendingTitle')}</h1>

    <p class="mt-3 leading-relaxed text-ink-muted">
      {t('auth.pendingBody')}
    </p>

    {
      wasRejected && (
        <p class="mt-4 rounded-lg border border-line bg-surface-sunken px-4 py-3 text-sm text-ink-muted">
          This account was not approved. If you think that is a mistake, speak to
          the hub administrator.
        </p>
      )
    }

    <p class="mt-6 text-xs text-ink-muted">
      {t('auth.signedInAs')} <span class="font-medium text-navy">{user?.email}</span>
    </p>

    <form method="POST" action="/auth/signout" class="mt-6">
      <button
        type="submit"
        class="rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-surface-sunken"
      >
        {t('nav.signOut')}
      </button>
    </form>
  </section>
</Layout>
